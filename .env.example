# ==============================================================================
# NEXORA INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# Tagline: Every Connection Reveals a Clue.
# Copy this file to .env and configure values for your local environment.
# NEVER commit .env files containing real keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
PROJECT_NAME="NEXORA Intelligence Platform"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# AI PROVIDER POLICY & CONFIGURATION
# ------------------------------------------------------------------------------
# Default provider for local offline intelligence: "ollama" (model: gemma4)
# Optional hosted provider: "gemini" (requires GEMINI_API_KEY)
# Inactive / strictly deterministic mode: "none"
# Note: Core analytical capabilities run completely without an AI provider.
AI_PROVIDER="none"

# Ollama Local Configuration (Gemma 4 E4B)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4"
OLLAMA_TIMEOUT_SECONDS=60

# Google Gemini API Configuration (Optional Hosted Provider)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (NEXT.JS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="NEXORA"
NEXT_PUBLIC_APP_TAGLINE="Every Connection Reveals a Clue."
NEXT_PUBLIC_ENVIRONMENT="development"
